{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5500",
        "--bind",
        "127.0.0.1",
        "--directory",
        "frontend"
      ],
      "port": 5500,
      "url": "http://127.0.0.1:5500"
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5501",
        "--bind",
        "127.0.0.1",
        "--directory",
        "frontend"
      ],
      "port": 5501,
      "url": "http://127.0.0.1:5501"
    },
    {
      "name": "app",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    }
  ]
}
